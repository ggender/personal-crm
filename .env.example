# Copy is created by "pnpm env:init" with random secrets. Never commit .env.
# Running "pnpm env:init" again adds the lines that are missing and changes nothing else.

# Password for the local PostgreSQL in Docker (docker-compose.yml)
POSTGRES_PASSWORD=

# Host port for PostgreSQL (5432 is often taken by a locally installed Postgres)
POSTGRES_PORT=5433

# Connection string used by the app, migrations and seed:
# postgres://crm:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/crm
DATABASE_URL=

# Signs the login cookies. A long random string, created by "pnpm env:init". On the server -
# its own value in /srv/personal-crm/.env.
BETTER_AUTH_SECRET=

# Address of the app that the login links in the emails point to.
# On the computer: http://localhost:3000. On the server it is set in deploy/compose.yaml.
BETTER_AUTH_URL=http://localhost:3000

# Where the app sends emails. On the computer: Mailpit from docker-compose.yml
# (smtp://127.0.0.1:1025, the emails are on http://localhost:8025).
# On the server: smtps://resend:<Resend API key>@smtp.resend.com:465
SMTP_URL=smtp://127.0.0.1:1025

# The sender of the login emails. The domain must be verified in Resend.
MAIL_FROM="Личная CRM <noreply@mail.crm.vprodcrm.ru>"

# Your email. The migration gives all contacts and groups that already exist to the user with
# this email, and "pnpm db:seed" puts the demo data there. Required while the database has data.
OWNER_EMAIL=
