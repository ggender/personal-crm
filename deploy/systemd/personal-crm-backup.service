# Daily backup of the personal-crm prod database: runs deploy/daily-backup.sh as the deploy user.
# Started by personal-crm-backup.timer. Installed by hand, see README.
[Unit]
Description=Daily backup of the personal-crm prod database
After=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/srv/personal-crm/daily-backup.sh
