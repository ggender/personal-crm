# Secrets of one environment on the server, owner deploy, mode 600: /srv/personal-crm/.env for prod,
# /srv/personal-crm-staging/.env for staging. Every environment has its own values (database
# password, cookie secret, Resend API key). Fill it on the server only; never commit real values.

# Password of the environment's PostgreSQL (hex, so it is safe inside the connection URL).
# Set it once before the first deploy: the database keeps the password it was created with.
POSTGRES_PASSWORD=

# Signs the login cookies. A long random string, made once on the server and never shown:
#   printf 'BETTER_AUTH_SECRET=%s\n' "$(openssl rand -hex 32)" | sudo tee -a <folder>/.env >/dev/null
# Changing it logs everybody out.
BETTER_AUTH_SECRET=

# The mail server that sends the login emails (Resend, domain mail.crm.vprodcrm.ru). The password is
# the Resend API key with the right to send, its own key for each environment:
# https://resend.com/api-keys
#   smtps://resend:<API key>@smtp.resend.com:465
# If the hoster closes port 465, use 2465 (the address stays the same otherwise).
SMTP_URL=

# Your email. The migration gives the contacts and groups that already exist to the user with this
# email, and you see them after you log in with it. Needed while the database has data.
OWNER_EMAIL=
